# Supabase-project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Geheime sleutel om de sessie-cookie te ondertekenen (willekeurige lange string)
SESSION_SECRET=

# Geheim om IP-adres/gebruikersnaam mee te hashen voor de login-rate-limit (willekeurige lange string)
RATE_LIMIT_SALT=

# Basis-URL van deze app, voor links in e-mails (bevestiging, wachtwoord-herstel).
# Verplicht in productie, bv. https://huisbalans.vercel.app — lokaal niet nodig
# (valt dan terug op de request-headers, dus gewoon leeg laten).
SITE_URL=
